From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OneTerm <oneterm@local>
Date: Fri, 10 Jul 2026 00:00:00 +0000
Subject: [PATCH 2/2] OneTerm fork: make gpui-component manifest standalone

Inlines the workspace-provided edition and dependency versions so the vendored
crates/ui package builds independently when redirected through Cargo's [patch].
The package remains excluded from the OneTerm workspace and keeps the pinned GPUI
and gpui-component dependency revisions.
---
 crates/ui/Cargo.toml | 51 ++++++++++++++++++++++----------------------
 1 file changed, 25 insertions(+), 26 deletions(-)

diff --git a/crates/ui/Cargo.toml b/crates/ui/Cargo.toml
index bd45543e..c9010ab7 100644
--- a/crates/ui/Cargo.toml
+++ b/crates/ui/Cargo.toml
@@ -9,7 +9,7 @@ repository = "https://github.com/longbridge/gpui-component"
 readme = "../../README.md"
 version = "0.5.2"
 publish = true
-edition.workspace = true
+edition = "2024"
 
 [lib]
 doctest = false
@@ -94,22 +94,22 @@ tree-sitter-yaml = ["dep:tree-sitter-yaml"]
 tree-sitter-zig = ["dep:tree-sitter-zig"]
 
 [dependencies]
-anyhow.workspace = true
-gpui = { workspace = true }
-gpui_macros.workspace = true
-gpui-component-macros = { workspace = true }
-gpui-component-assets = { workspace = true }
-notify.workspace = true
-ropey.workspace = true
-rust-i18n.workspace = true
-schemars.workspace = true
-serde.workspace = true
-serde_json.workspace = true
-serde_repr.workspace = true
-smallvec.workspace = true
-sum-tree.workspace = true
-tracing.workspace = true
-log.workspace = true
+anyhow = "1"
+gpui = { git = "https://github.com/zed-industries/zed", rev = "1d217ee39d381ac101b7cf49d3d22451ac1093fe" }
+gpui_macros = { git = "https://github.com/zed-industries/zed", rev = "1d217ee39d381ac101b7cf49d3d22451ac1093fe" }
+gpui-component-macros = { git = "https://github.com/longbridge/gpui-component", rev = "ea6b194db04cc7c0474851f07c7d5b7a9df6a98b" }
+gpui-component-assets = { git = "https://github.com/longbridge/gpui-component", rev = "ea6b194db04cc7c0474851f07c7d5b7a9df6a98b" }
+notify = "7.0.0"
+ropey = { version = "=2.0.0-beta.1", features = ["metric_lines_lf", "metric_utf16"] }
+rust-i18n = "4"
+schemars = "1"
+serde = { version = "1.0.219", features = ["derive"] }
+serde_json = "1"
+serde_repr = "0.1"
+smallvec = "1"
+sum-tree = { version = "0.2.0", package = "zed-sum-tree" }
+tracing = "0.1.41"
+log = "0.4"
 
 enum-iterator = "2.1.0"
 itertools = "0.13.0"
@@ -139,14 +139,14 @@ chrono = "0.4.38"
 
 # Code Editor
 aho-corasick = "1.1.3"
-lsp-types.workspace = true
+lsp-types = { version = "0.97.0", features = ["proposed"] }
 
 # Cross-platform time APIs (zero-cost on native, uses web APIs on WASM)
 instant = { version = "0.1", features = ["wasm-bindgen"] }
 
 # Native-only dependencies (not available on WASM)
 [target.'cfg(not(target_family = "wasm"))'.dependencies]
-smol.workspace = true
+smol = "2"
 tree-sitter = "0.26"
 tree-sitter-astro-next = { version="0.1.1", optional = true }
 tree-sitter-bash = { version = "0.23.3", optional = true }
@@ -186,7 +186,7 @@ tree-sitter-zig = { version = "1.1.2", optional = true }
 [target.'cfg(target_os = "macos")'.dependencies]
 core-text = "=21.0.0"
 # Native menu (NativeMenu) — drives AppKit NSMenu via objc2.
-raw-window-handle = { workspace = true }
+raw-window-handle = "0.6.2"
 objc2 = "0.6"
 objc2-app-kit = { version = "0.3", features = [
     "NSMenu",
@@ -199,8 +199,8 @@ objc2-foundation = { version = "0.3", features = ["NSString", "NSGeometry"] }
 
 [target.'cfg(target_os = "windows")'.dependencies]
 # Native menu (NativeMenu) — drives Win32 popup menus.
-raw-window-handle = { workspace = true }
-windows = { workspace = true, features = [
+raw-window-handle = "0.6.2"
+windows = { version = "0.58.0", features = [
     "Win32_Foundation",
     "Win32_Graphics_Gdi",
     "Win32_UI_Input_KeyboardAndMouse",
@@ -208,12 +208,9 @@ windows = { workspace = true, features = [
 ] }
 
 [dev-dependencies]
-gpui = { workspace = true, features = ["test-support"] }
+gpui = { git = "https://github.com/zed-industries/zed", rev = "1d217ee39d381ac101b7cf49d3d22451ac1093fe", features = ["test-support"] }
 indoc = "2"
 
-[lints]
-workspace = true
-
 # `gpui-component-assets` ships the canonical icon set whose variants we
 # enumerate to generate `IconName` at build time. Cargo's
 # `DEP_<links>_<key>` propagation (the bridge that hands the icons-dir
@@ -222,3 +219,5 @@ workspace = true
 # though our use is entirely build-time.
 [package.metadata.cargo-machete]
 ignored = ["gpui-component-assets"]
+
+[workspace]
