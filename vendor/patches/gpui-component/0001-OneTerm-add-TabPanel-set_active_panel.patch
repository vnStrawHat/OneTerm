From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OneTerm <oneterm@local>
Date: Fri, 10 Jul 2026 00:00:00 +0000
Subject: [PATCH 1/2] OneTerm fork: expose TabPanel::set_active_panel

Adds a public, panel-keyed wrapper around TabPanel's private set_active_ix method.
This lets Agent navigation activate an existing panel without reaching into GPUI's
private tab-selection implementation.
---
 crates/ui/src/dock/tab_panel.rs | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/crates/ui/src/dock/tab_panel.rs b/crates/ui/src/dock/tab_panel.rs
index 1d88d28b..5e224642 100644
--- a/crates/ui/src/dock/tab_panel.rs
+++ b/crates/ui/src/dock/tab_panel.rs
@@ -207,6 +207,28 @@ impl TabPanel {
         }
     }
 
+    /// Activate the tab whose panel matches `panel` (by `entity_id`).
+    ///
+    /// No-op if `panel` is not in this `TabPanel` or is already the active
+    /// tab. This is the public, panel-keyed wrapper around the private
+    /// `set_active_ix`, which is otherwise only reachable from tab clicks /
+    /// add-remove.
+    pub fn set_active_panel(
+        &mut self,
+        panel: &Arc<dyn PanelView>,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) {
+        let target_id = panel.view().entity_id();
+        if let Some(ix) = self
+            .panels
+            .iter()
+            .position(|p| p.view().entity_id() == target_id)
+        {
+            self.set_active_ix(ix, window, cx);
+        }
+    }
+
     pub fn active_ix(&self) -> usize {
         self.active_ix
     }
