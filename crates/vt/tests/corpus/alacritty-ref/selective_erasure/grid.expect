# OneTerm VT parity expectation: the grid, cell-exact, nothing trimmed.
# Blessed by the vendored alacritty_terminal engine at US-0072 and FROZEN.
# Rows are newest first. Each run is `<count>*<content>;<attrs>;<fg>;<bg>;<underline>;<hyperlink>`.
# Do not hand-edit: regenerate with `vt-corpus bless --engine old --deviation <id>`.
version 1
columns 10
lines 3
display_offset 0
rows 3
row 0 wrap=0 10*0020;-;nForeground;nBackground;-;-
row 1 wrap=0 1*0041;-;nForeground;nBackground;-;-|1*0042;-;nForeground;nBackground;-;-|1*0043;-;nForeground;nBackground;-;-|7*0020;-;nForeground;nBackground;-;-
row 2 wrap=0 1*0041;-;nForeground;nBackground;-;-|1*0042;-;nForeground;nBackground;-;-|1*0043;-;nForeground;nBackground;-;-|7*0020;-;nForeground;nBackground;-;-
