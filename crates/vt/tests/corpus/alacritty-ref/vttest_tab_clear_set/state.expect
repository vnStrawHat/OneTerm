# OneTerm VT parity expectation: cursor, modes, palette, title, tab stops,
# scroll region. Blessed by the vendored engine at US-0072 and FROZEN.
version 1
cursor row=4 col=35 shape=Block
pending_wrap 0
modes ALTERNATE_SCROLL LINE_WRAP SHOW_CURSOR URGENCY_HINTS
title_events 0
tab_stops 6,12,18,24,30,36,42,48,54,60,66,72,78,115
scroll_region top=0 bottom=30
