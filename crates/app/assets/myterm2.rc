// Windows resource script cho myTerm2.
//
// Nhúng app icon (đa độ phân giải) vào tài nguyên của myterm2.exe.
// Windows Explorer / taskbar / Alt-Tab sẽ chọn kích thước phù hợp nhất.
//
// Path trong .rc **phải** tương đối so với vị trí file .rc này.
// File này nằm ở: crates/app/assets/myterm2.rc
// Icon nằm ở:     crates/app/assets/icons/*.ico

// ID thấp nhất ⇒ icon mặc định của executable trong Explorer.
APP_ICON_48 ICON "icons/terminal-48x48.ico"
APP_ICON_96 ICON "icons/terminal-96x96.ico"

#include <windows.h>

// Version info — hiển thị trong Properties > Details của exe.
#define VER_FILEVERSION            0,0,1,0
#define VER_FILEVERSION_STR        "0.0.1.0"
#define VER_PRODUCTVERSION         0,0,1,0
#define VER_PRODUCTVERSION_STR     "0.0.1.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "myTerm2"
            VALUE "FileDescription",  "myTerm2 — SSH / SFTP / LocalShell GUI Client"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "myterm2"
            VALUE "OriginalFilename", "myterm2.exe"
            VALUE "ProductName",      "myTerm2"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0  // English (US) + Unicode
    END
END