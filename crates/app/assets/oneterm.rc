// Windows resource script cho OneTerm.
//
// Nhúng app icon (đa độ phân giải) vào tài nguyên của exe (oneterm-debug ở dev, oneterm ở release).
// Windows Explorer / taskbar / Alt-Tab sẽ chọn kích thước phù hợp nhất.
//
// Path trong .rc **phải** tương đối so với vị trí file .rc này.
// File này nằm ở: crates/app/assets/oneterm.rc
// Icon nằm ở:     crates/app/assets/icons/*.ico
//
// Hai bin target (xem crates/app/Cargo.toml): oneterm-debug (dev, feature dev-bin)
// và oneterm (release, feature release-bin). Cả hai đều nhúng cùng resource này.
// Version info dưới đây mô tả artifact release (OneTerm).

// ID thấp nhất ⇒ icon mặc định của executable trong Explorer.
APP_ICON_48 ICON "icons/terminal-48x48.ico"
APP_ICON_96 ICON "icons/terminal-96x96.ico"

#include <windows.h>

// Version info — hiển thị trong Properties > Details của exe.
#define VER_FILEVERSION            0,0,1,0
#define VER_FILEVERSION_STR        "0.0.1.0"
#define VER_PRODUCTVERSION         0,0,1,0
#define VER_PRODUCTVERSION_STR     "0.0.1.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OneTerm"
            VALUE "FileDescription",  "OneTerm - SSH / SFTP / LocalShell GUI Client"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "oneterm"
            VALUE "OriginalFilename", "oneterm.exe"
            VALUE "ProductName",      "OneTerm"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0  // English (US) + Unicode
    END
END
