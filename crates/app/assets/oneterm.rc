// Windows resource script template for OneTerm.
//
// WARNING: This is a TEMPLATE — it is NOT compiled directly. build.rs
// (crates/app/build.rs) reads this file, substitutes the {{...}} placeholders
// with real values (version from the repo-root VERSION file, absolute icon
// paths), writes the result to OUT_DIR, and compiles that generated file.
//
// Placeholders:
//   {{ASSETS_DIR}}    -> absolute path to crates/app/assets (for icon paths)
//   {{VERSION_COMMA}} -> 4 comma-separated ints, e.g. "0,1,0,0" (FILEVERSION/PRODUCTVERSION)
//   {{VERSION_STR}}   -> 4 dot-separated ints,   e.g. "0.1.0.0" (FileVersion/ProductVersion string)
//
// Numeric resource ID 1 => the default executable icon in Explorer AND the
// icon gpui's Windows backend loads for every window class (it calls
// LoadImageW(.., PCWSTR(1), ..) — a NAMED resource like APP_ICON_48 will NOT
// match, leaving windows with a null/default icon). So the primary icon must
// use numeric ID 1.
1 ICON "{{ASSETS_DIR}}/icons/terminal-48x48.ico"
2 ICON "{{ASSETS_DIR}}/icons/terminal-96x96.ico"

#include <windows.h>

// Version info — shown in the exe's Properties > Details tab.
#define VER_FILEVERSION            {{VERSION_COMMA}}
#define VER_FILEVERSION_STR        "{{VERSION_STR}}"
#define VER_PRODUCTVERSION         {{VERSION_COMMA}}
#define VER_PRODUCTVERSION_STR     "{{VERSION_STR}}"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OneTerm"
            VALUE "FileDescription",  "OneTerm - SSH/SFTP/LocalShell GUI Client"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "oneterm"
            VALUE "OriginalFilename", "oneterm.exe"
            VALUE "ProductName",      "OneTerm"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0  // English (US) + Unicode
    END
END