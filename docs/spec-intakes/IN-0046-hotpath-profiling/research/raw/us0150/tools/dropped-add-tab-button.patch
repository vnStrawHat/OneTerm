diff --git a/crates/terminal-view/src/panel/tests.rs b/crates/terminal-view/src/panel/tests.rs
index 8a74bb3d..f36777de 100644
--- a/crates/terminal-view/src/panel/tests.rs
+++ b/crates/terminal-view/src/panel/tests.rs
@@ -968,3 +968,55 @@ fn the_catch_up_in_a_hidden_tab_releases_without_notifying(cx: &mut TestAppConte
         "the catch-up notified a hidden tab's view"
     );
 }
+
+/// `US-0150`: the tab bar embeds the "+" button as a cached view laid out at
+/// `size_5` (1.25 rem square) rather than measured, so that must be the size
+/// the button draws at — at any UI font size.
+#[gpui::test]
+fn the_add_tab_button_is_the_size_it_is_cached_at(cx: &mut TestAppContext) {
+    use gpui::{
+        Context, Entity, InteractiveElement as _, IntoElement, ParentElement as _, Render,
+        Styled as _, Window, div, px,
+    };
+
+    use crate::panel::terminal_panel::AddTabButton;
+
+    struct Host {
+        button: Entity<AddTabButton>,
+        rem: gpui::Pixels,
+    }
+
+    impl Render for Host {
+        fn render(&mut self, window: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            window.set_rem_size(self.rem);
+            // The kit's tab bar suffix is a centred row; so is this.
+            div().flex().items_center().h(px(40.)).child(
+                div()
+                    .debug_selector(|| "add-tab-button".into())
+                    .child(self.button.clone()),
+            )
+        }
+    }
+
+    cx.update(gpui_component::init);
+    let (host, cx) = cx.add_window_view(|_, cx| Host {
+        button: cx.new(|_| AddTabButton),
+        rem: px(16.),
+    });
+    for rem in [12., 16., 20.] {
+        host.update(cx, |host, cx| {
+            host.rem = px(rem);
+            cx.notify();
+        });
+        cx.run_until_parked();
+        let size = cx
+            .debug_bounds("add-tab-button")
+            .expect("button drawn")
+            .size;
+        assert_eq!(
+            size,
+            gpui::size(px(rem * 1.25), px(rem * 1.25)),
+            "rem {rem}"
+        );
+    }
+}
