# EditorConfig — https://editorconfig.org
# Rust formatting is owned by rustfmt (.rustfmt.toml); this file covers everything else
# (Python, PowerShell, Bash, JSON, YAML, TOML, Markdown) and keeps line endings LF.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown hard line break.
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2

[*.ps1]
indent_size = 4

[*.py]
indent_size = 4

# Vendored upstream sources and generated patches must stay byte-exact.
[vendor/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
